{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/credential-confirmed-response.schema.json",
  "title": "Daylight v1 credential confirmed response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "status",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
    },
    "status": {
      "const": "active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
