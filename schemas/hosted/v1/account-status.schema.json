{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/account-status.schema.json",
  "title": "Daylight v1 account status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_id",
    "status",
    "active_installation_id",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    },
    "active_installation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_ai",
        "email_intake",
        "source_delivery"
      ],
      "properties": {
        "managed_ai": {
          "type": "boolean"
        },
        "email_intake": {
          "type": "boolean"
        },
        "source_delivery": {
          "type": "boolean"
        }
      }
    }
  }
}
