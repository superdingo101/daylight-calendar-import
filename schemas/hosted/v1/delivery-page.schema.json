{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/delivery-page.schema.json",
  "title": "Daylight H3 source poll page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliveries",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deliveries": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "https://docs.daylightcalendar.com/schemas/hosted/v1/delivery-item.schema.json"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    }
  }
}
