{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/credential-issued-response.schema.json",
  "title": "Daylight v1 credential issued response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_id",
    "installation_token",
    "expires_at",
    "confirmation_expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
    },
    "installation_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{43,256}(?![\\s\\S])"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
