{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/event-draft.schema.json",
  "title": "Daylight Hosted API v1 EventDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "start", "end", "all_day", "location", "description", "confidence"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "start": {"type": "string"},
    "end": {"type": "string"},
    "all_day": {"type": "boolean"},
    "location": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
    "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 65536},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [{
    "if": {"properties": {"all_day": {"const": true}}, "required": ["all_day"]},
    "then": {"properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}},
    "else": {"properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}}
  }]
}
