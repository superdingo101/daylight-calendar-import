{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.daylightcalendar.com/schemas/hosted/v1/pairing-start-request.schema.json",
  "title": "Daylight v1 pairing start request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code_challenge",
    "code_challenge_method",
    "installation_label"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "code_challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])"
    },
    "code_challenge_method": {
      "const": "S256"
    },
    "installation_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
